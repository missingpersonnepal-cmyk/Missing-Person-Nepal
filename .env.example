# Aiven PostgreSQL connection string. Keep credentials out of Git.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# App/session settings
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me

# Runtime
APP_ENV=development
AUTO_CREATE_TABLES=true
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
UPLOAD_DIR=uploads
EXPORT_DIR=exports

# Discovery bot safety limits
DISCOVERY_MAX_QUERIES_PER_RUN=12
DISCOVERY_RESULTS_PER_QUERY=8
DISCOVERY_REQUEST_DELAY_SECONDS=1.0
DISCOVERY_TIMEOUT_SECONDS=15
